---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({
    params: { slug: p.id },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} · 王同学`}
  description={post.data.description}
  ogType="article"
>
  <article class="container" style="padding-top:80px;max-width:760px;">
    <a href="/blog" class="back-link mono">← 返回文章列表</a>
    <h1 style="font-size:clamp(28px,5vw,40px);margin:24px 0 16px;">{post.data.title}</h1>
    <div class="meta-row">
      <span class="mono" style="color:var(--text-dim);font-size:13px;">{post.data.pubDate.toLocaleDateString('zh-CN')}</span>
      {post.data.tags.map((t) => <span class="keyword">{t}</span>)}
    </div>
    <div class="prose" style="margin-top:40px;">
      <Content />
    </div>
    <div style="margin-top:64px;padding-top:24px;border-top:1px solid var(--border);">
      <a href="/blog" class="card-link">← 看更多文章</a>
    </div>
  </article>
</BaseLayout>

<style>
  .back-link { color: var(--text-dim); font-size: 12px; letter-spacing: 0.1em; }
  .back-link:hover { color: var(--accent); }
  .meta-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .prose :global(h2) { font-size: 24px; margin: 32px 0 16px; }
  .prose :global(h3) { font-size: 20px; margin: 24px 0 12px; }
  .prose :global(p) { color: var(--text-muted); margin: 16px 0; line-height: 1.8; }
  .prose :global(ul) { color: var(--text-muted); margin: 16px 0 16px 20px; }
  .prose :global(li) { margin: 6px 0; line-height: 1.8; }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); padding-left: 16px; color: var(--text-muted); margin: 20px 0; }
  .prose :global(code) { background: var(--bg-elevated); padding: 2px 6px; border-radius: 4px; font-family: 'JetBrains Mono', monospace; font-size: 13px; }
  .prose :global(pre) { background: var(--bg-elevated); padding: 16px; border-radius: 8px; overflow-x: auto; margin: 16px 0; }
  .prose :global(pre code) { background: transparent; padding: 0; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
</style>
